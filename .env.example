# Compose template: root .env is for Docker Compose interpolation.
# docker compose --env-file .env.example up --build uses offline Demo defaults.
# Backend defaults from app/core/config.py; all API keys intentionally empty.
# Local: copy to backend/.env and run commands from backend/.
# Restart the backend after changing settings.
APP_ENV=development
DATABASE_URL=sqlite:///./smart_shopping.db
SECRET_KEY=change-this-before-production
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TAVILY_API_KEY=
LLM_TIMEOUT_SECONDS=30
SEARCH_TIMEOUT_SECONDS=15
LLM_RETRY_COUNT=2
SEARCH_RETRY_COUNT=1
MAX_SEARCH_QUERIES=4
MAX_RESULTS_PER_QUERY=5
TOP_K=5
DEMO_MODE=true
CACHE_TTL_SECONDS=1800
PRODUCT_OFFER_FRESHNESS_TTL_SECONDS=3600
COLLECTOR_MAX_URLS=5
COLLECTOR_LIVE_ENABLED=false
COLLECTOR_POLICY_CONFIRMED=false
COLLECTOR_SOURCE_REGISTRY_JSON=[]
COLLECTOR_MAX_PAGES=2
COLLECTOR_MAX_BYTES=2000000
COLLECTOR_HTTP_TIMEOUT_SECONDS=8
COLLECTOR_MIN_INTERVAL_SECONDS=1
COLLECTOR_BROWSER_ENABLED=false
COLLECTOR_BROWSER_TIMEOUT_SECONDS=12
COLLECTOR_BROWSER_MAX_DOM_BYTES=2000000
ENABLE_LLM_EXTRACTION_FALLBACK=false
LLM_EXTRACTION_MAX_INPUT_CHARS=12000
LLM_EXTRACTION_CACHE_TTL_SECONDS=3600

# Frontend public URL (Compose build arg; contains no secret).
# Local frontend override belongs in frontend/.env.local.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
